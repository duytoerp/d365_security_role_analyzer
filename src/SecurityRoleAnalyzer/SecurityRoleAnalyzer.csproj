<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyTitle>D365 Security Role Analyzer</AssemblyTitle>
    <Version>3.0.1</Version>
    <!-- Program.Main tự quyết định mở giao diện hay chạy chế độ dòng lệnh. -->
    <StartupObject>SecurityRoleAnalyzer.Program</StartupObject>
  </PropertyGroup>

  <!-- dotnet publish -p:Edition=Viewer: bản chỉ xem, khóa mọi thao tác ghi lên Dataverse (xem Services/AppEdition.cs). -->
  <PropertyGroup Condition="'$(Edition)' == 'Viewer'">
    <DefineConstants>$(DefineConstants);VIEWER</DefineConstants>
    <AssemblyTitle>D365 Security Role Analyzer Viewer</AssemblyTitle>
    <Product>D365 Security Role Analyzer Viewer</Product>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SecurityRoleAnalyzer.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.PowerPlatform.Dataverse.Client" Version="1.2.27" />
  </ItemGroup>

</Project>

