<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Bảng màu tối. Phải có đủ mọi key như Light.xaml. -->

    <!-- Nền & bề mặt -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#14181D" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#1C2128" />
    <SolidColorBrush x:Key="SubtleBrush" Color="#22272E" />
    <SolidColorBrush x:Key="PanelBrush" Color="#1A2029" />
    <SolidColorBrush x:Key="AltRowBrush" Color="#20252C" />
    <SolidColorBrush x:Key="OverlayBrush" Color="#99141821" />

    <!-- Viền & đường kẻ -->
    <SolidColorBrush x:Key="BorderBrush" Color="#30363D" />
    <SolidColorBrush x:Key="GridLineBrush" Color="#333B44" />

    <!-- Chữ -->
    <SolidColorBrush x:Key="TextBrush" Color="#E6EDF3" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#9198A1" />
    <SolidColorBrush x:Key="HintBrush" Color="#6E7B8A" />

    <!-- Nhấn & trạng thái -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="#2F81F7" />
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#4C96F8" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FF7B72" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#1F3A57" />

    <!-- Header -->
    <SolidColorBrush x:Key="HeaderBrush" Color="#0B2238" />
    <SolidColorBrush x:Key="NavForegroundBrush" Color="#9FBBD6" />
    <SolidColorBrush x:Key="NavHoverBrush" Color="#16344F" />
    <SolidColorBrush x:Key="NavActiveBrush" Color="#1E4E78" />

    <!-- Banner cảnh báo -->
    <SolidColorBrush x:Key="WarningBackgroundBrush" Color="#3A2F12" />
    <SolidColorBrush x:Key="WarningBorderBrush" Color="#7A5B00" />
    <SolidColorBrush x:Key="WarningTextBrush" Color="#F2D57E" />

    <!-- Banner thông tin -->
    <SolidColorBrush x:Key="InfoBackgroundBrush" Color="#16314D" />
    <SolidColorBrush x:Key="InfoBorderBrush" Color="#2C5D93" />
    <SolidColorBrush x:Key="InfoTextBrush" Color="#A8CFF5" />

    <!-- Ô quyền đã sửa nhưng chưa lưu -->
    <SolidColorBrush x:Key="ChangedCellBrush" Color="#4A3C10" />

    <!-- Mức quyền -->
    <SolidColorBrush x:Key="DepthNoneBrush" Color="#5A626B" />
    <SolidColorBrush x:Key="DepthUserBrush" Color="#4CAF50" />
    <SolidColorBrush x:Key="DepthBusinessUnitBrush" Color="#4C96F8" />
    <SolidColorBrush x:Key="DepthParentChildBrush" Color="#E0A33B" />
    <SolidColorBrush x:Key="DepthOrganizationBrush" Color="#FF7B72" />

    <!-- Mức độ nghiêm trọng -->
    <SolidColorBrush x:Key="SeverityHighBrush" Color="#FF7B72" />
    <SolidColorBrush x:Key="SeverityMediumBrush" Color="#E0A33B" />
    <SolidColorBrush x:Key="SeverityLowBrush" Color="#4C96F8" />
    <SolidColorBrush x:Key="SeverityInfoBrush" Color="#9198A1" />
</ResourceDictionary>
