<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Bảng màu sáng. Mọi màu dùng trong giao diện phải lấy từ đây (DynamicResource) để đổi theme được. -->

    <!-- Nền & bề mặt -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F3F5F8" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SubtleBrush" Color="#F6F8FA" />
    <SolidColorBrush x:Key="PanelBrush" Color="#F0F4F8" />
    <SolidColorBrush x:Key="AltRowBrush" Color="#FAFBFC" />
    <SolidColorBrush x:Key="OverlayBrush" Color="#99F3F5F8" />

    <!-- Viền & đường kẻ -->
    <SolidColorBrush x:Key="BorderBrush" Color="#E1E4E8" />
    <SolidColorBrush x:Key="GridLineBrush" Color="#D0D7DE" />

    <!-- Chữ -->
    <SolidColorBrush x:Key="TextBrush" Color="#1F2328" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#656D76" />
    <SolidColorBrush x:Key="HintBrush" Color="#9FB3C8" />

    <!-- Nhấn & trạng thái -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="#0F6CBD" />
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#115EA3" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="DangerBrush" Color="#C50F1F" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#DCEBFA" />

    <!-- Header (giữ tông xanh đậm ở cả hai theme) -->
    <SolidColorBrush x:Key="HeaderBrush" Color="#0B3A66" />
    <SolidColorBrush x:Key="NavForegroundBrush" Color="#B9CFE4" />
    <SolidColorBrush x:Key="NavHoverBrush" Color="#1A4F80" />
    <SolidColorBrush x:Key="NavActiveBrush" Color="#23629B" />

    <!-- Banner cảnh báo -->
    <SolidColorBrush x:Key="WarningBackgroundBrush" Color="#FFF8E1" />
    <SolidColorBrush x:Key="WarningBorderBrush" Color="#F2D57E" />
    <SolidColorBrush x:Key="WarningTextBrush" Color="#7A5B00" />

    <!-- Banner thông tin -->
    <SolidColorBrush x:Key="InfoBackgroundBrush" Color="#EAF3FC" />
    <SolidColorBrush x:Key="InfoBorderBrush" Color="#B7D4F0" />
    <SolidColorBrush x:Key="InfoTextBrush" Color="#0B4A85" />

    <!-- Ô quyền đã sửa nhưng chưa lưu -->
    <SolidColorBrush x:Key="ChangedCellBrush" Color="#FFF3C4" />

    <!-- Mức quyền -->
    <SolidColorBrush x:Key="DepthNoneBrush" Color="#C9CDD2" />
    <SolidColorBrush x:Key="DepthUserBrush" Color="#2E7D32" />
    <SolidColorBrush x:Key="DepthBusinessUnitBrush" Color="#0F6CBD" />
    <SolidColorBrush x:Key="DepthParentChildBrush" Color="#B26B00" />
    <SolidColorBrush x:Key="DepthOrganizationBrush" Color="#C50F1F" />

    <!-- Mức độ nghiêm trọng -->
    <SolidColorBrush x:Key="SeverityHighBrush" Color="#C50F1F" />
    <SolidColorBrush x:Key="SeverityMediumBrush" Color="#B26B00" />
    <SolidColorBrush x:Key="SeverityLowBrush" Color="#0F6CBD" />
    <SolidColorBrush x:Key="SeverityInfoBrush" Color="#656D76" />
</ResourceDictionary>
