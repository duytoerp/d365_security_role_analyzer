<Window x:Class="SecurityRoleAnalyzer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SecurityRoleAnalyzer.ViewModels"
        xmlns:m="clr-namespace:SecurityRoleAnalyzer.Models"
        xmlns:c="clr-namespace:SecurityRoleAnalyzer.Controls"
        xmlns:v="clr-namespace:SecurityRoleAnalyzer.Views"
        Title="D365 Security Role Analyzer" Height="860" Width="1480" MinWidth="1000" MinHeight="600"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="13"
        Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource TextBrush}">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
        <KeyBinding Key="F1" Command="{Binding ShowShortcutsCommand}" />
        <KeyBinding Key="F" Modifiers="Ctrl" Command="{Binding FocusSearchCommand}" />
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SavePrivilegesCommand}" />
        <KeyBinding Key="E" Modifiers="Ctrl" Command="{Binding ExportCommand}" />
        <KeyBinding Key="K" Modifiers="Ctrl" Command="{Binding ConnectCommand}" />
        <KeyBinding Key="C" Modifiers="Ctrl+Shift" Command="{Binding CopySelectionCommand}" />
        <KeyBinding Key="H" Modifiers="Ctrl" Command="{Binding OpenHistoryCommand}" />
        <KeyBinding Key="L" Modifiers="Ctrl" Command="{Binding OpenLookupCommand}" />
        <KeyBinding Key="D1" Modifiers="Ctrl" Command="{Binding SetModeCommand}" CommandParameter="Roles" />
        <KeyBinding Key="D2" Modifiers="Ctrl" Command="{Binding SetModeCommand}" CommandParameter="Teams" />
        <KeyBinding Key="D3" Modifiers="Ctrl" Command="{Binding SetModeCommand}" CommandParameter="Users" />
        <KeyBinding Key="D4" Modifiers="Ctrl" Command="{Binding SetModeCommand}" CommandParameter="Apps" />
        <KeyBinding Key="D5" Modifiers="Ctrl" Command="{Binding SetModeCommand}" CommandParameter="FieldSecurity" />
        <KeyBinding Key="D6" Modifiers="Ctrl" Command="{Binding SetModeCommand}" CommandParameter="BusinessUnits" />
    </Window.InputBindings>

    <Grid>
        <DockPanel>
            <!-- Header -->
            <Border DockPanel.Dock="Top" Background="{DynamicResource HeaderBrush}" Padding="16,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                        <TextBlock Text="Security Role Analyzer" FontSize="17" FontWeight="SemiBold" Foreground="White" />
                        <TextBlock Text="{Binding ConnectionText}" Foreground="{DynamicResource NavForegroundBrush}" FontSize="11.5" TextTrimming="CharacterEllipsis" MaxWidth="330" />
                    </StackPanel>

                    <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                        <RadioButton Content="🛡 Roles" Style="{StaticResource NavButton}" GroupName="Mode"
                                     IsChecked="{Binding Mode, Converter={StaticResource EnumEquals}, ConverterParameter=Roles}" />
                        <RadioButton Content="👥 Teams" Style="{StaticResource NavButton}" GroupName="Mode"
                                     IsChecked="{Binding Mode, Converter={StaticResource EnumEquals}, ConverterParameter=Teams}" />
                        <RadioButton Content="👤 Users" Style="{StaticResource NavButton}" GroupName="Mode"
                                     IsChecked="{Binding Mode, Converter={StaticResource EnumEquals}, ConverterParameter=Users}" />
                        <RadioButton Content="📱 Apps" Style="{StaticResource NavButton}" GroupName="Mode"
                                     IsChecked="{Binding Mode, Converter={StaticResource EnumEquals}, ConverterParameter=Apps}" />
                        <RadioButton Content="🔒 Field Security" Style="{StaticResource NavButton}" GroupName="Mode"
                                     IsChecked="{Binding Mode, Converter={StaticResource EnumEquals}, ConverterParameter=FieldSecurity}" />
                        <RadioButton Content="🏢 Business Units" Style="{StaticResource NavButton}" GroupName="Mode"
                                     IsChecked="{Binding Mode, Converter={StaticResource EnumEquals}, ConverterParameter=BusinessUnits}" />
                    </WrapPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" Width="230" DisplayMemberPath="DisplayName"
                                  ToolTip="Chuyển nhanh môi trường đã lưu" Margin="0,0,4,0" />
                        <Button Content="🔌 Kết nối" Command="{Binding ConnectCommand}" Style="{StaticResource PrimaryButton}" />
                        <Button Content="⟳" Command="{Binding RefreshCommand}" Style="{StaticResource HeaderButton}" ToolTip="Làm mới dữ liệu (xóa cache)" />
                        <Button x:Name="ToolsButton" Content="🧰 Công cụ ▾" Style="{StaticResource HeaderButton}" Click="OnToolsClick">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="🔎 Tra cứu ngược: ai có quyền X?" Command="{Binding OpenLookupCommand}" />
                                    <MenuItem Header="📋 Rà soát quyền toàn hệ thống (User × Role)" Command="{Binding OpenAccessReviewCommand}" />
                                    <MenuItem Header="⇄ So sánh 2 role" Command="{Binding CompareCommand}" />
                                    <MenuItem Header="⧉ Tìm role trùng lặp (gộp / dọn bớt)" Command="{Binding OpenRoleOverlapCommand}" />
                                    <MenuItem Header="🔍 Audit log phân quyền (từ D365)" Command="{Binding OpenAuditCommand}" />
                                    <Separator />
                                    <MenuItem Header="⚙ Áp quyền hàng loạt cho nhiều role" Command="{Binding OpenBulkPrivilegesCommand}" />
                                    <MenuItem Header="♻ Khôi phục privilege từ bản sao lưu" Command="{Binding RestoreBackupCommand}" />
                                    <MenuItem Header="📥 Import phân quyền từ Excel / CSV" Command="{Binding OpenImportCommand}" />
                                    <Separator />
                                    <MenuItem Header="📸 Snapshot &amp; so sánh môi trường" Command="{Binding OpenSnapshotCommand}" />
                                    <MenuItem Header="🕘 Lịch sử thao tác &amp; hoàn tác" Command="{Binding OpenHistoryCommand}" />
                                    <MenuItem Header="📂 Mở thư mục dữ liệu (cache, sao lưu, lịch sử)" Command="{Binding OpenDataFolderCommand}" />
                                    <Separator />
                                    <MenuItem Header="🎨 Giao diện">
                                        <MenuItem Header="Theo Windows" Command="{Binding SetThemeCommand}" CommandParameter="System"
                                                  IsChecked="{Binding IsThemeSystem, Mode=OneWay}" IsCheckable="False" />
                                        <MenuItem Header="Sáng" Command="{Binding SetThemeCommand}" CommandParameter="Light"
                                                  IsChecked="{Binding IsThemeLight, Mode=OneWay}" IsCheckable="False" />
                                        <MenuItem Header="Tối" Command="{Binding SetThemeCommand}" CommandParameter="Dark"
                                                  IsChecked="{Binding IsThemeDark, Mode=OneWay}" IsCheckable="False" />
                                    </MenuItem>
                                    <MenuItem Header="📐 Bộ quy tắc rà soát">
                                        <MenuItem Header="Mở policy.json để chỉnh sửa" Command="{Binding EditPolicyCommand}" />
                                        <MenuItem Header="Nạp lại bộ quy tắc" Command="{Binding ReloadPolicyCommand}" />
                                    </MenuItem>
                                    <MenuItem Header="🧾 Mở file log lỗi" Command="{Binding OpenErrorLogCommand}" />
                                    <MenuItem Header="⌨ Phím tắt" Command="{Binding ShowShortcutsCommand}" InputGestureText="F1" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Status bar -->
            <Border DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14,5">
                <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis" />
            </Border>

            <Grid x:Name="ModeContent">
            <v:TeamsView DataContext="{Binding TeamManager}" Visibility="{Binding DataContext.Mode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumVisibility}, ConverterParameter=Teams}" />
            <v:UsersView DataContext="{Binding UserManager}" Visibility="{Binding DataContext.Mode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumVisibility}, ConverterParameter=Users}" />
            <v:AppsView DataContext="{Binding AppManager}" Visibility="{Binding DataContext.Mode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumVisibility}, ConverterParameter=Apps}" />
            <v:FieldSecurityView DataContext="{Binding FieldSecurity}" Visibility="{Binding DataContext.Mode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumVisibility}, ConverterParameter=FieldSecurity}" />
            <v:BusinessUnitsView DataContext="{Binding BusinessUnits}" Visibility="{Binding DataContext.Mode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumVisibility}, ConverterParameter=BusinessUnits}" />

            <Grid Margin="12" Visibility="{Binding Mode, Converter={StaticResource EnumVisibility}, ConverterParameter=Roles}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320" MinWidth="220" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Role list -->
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Security Roles" Style="{StaticResource SectionTitle}" />
                        <TextBox DockPanel.Dock="Top" Style="{StaticResource SearchBox}" Tag="🔍 Tìm role..."
                                 Text="{Binding RoleSearchText, UpdateSourceTrigger=PropertyChanged}" />
                        <DockPanel DockPanel.Dock="Top" Margin="0,8">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding RoleCountText}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                            <CheckBox Content="Ẩn role managed" IsChecked="{Binding HideManagedRoles}" Margin="0" />
                        </DockPanel>
                        <ListBox ItemsSource="{Binding RolesView}" SelectedItem="{Binding SelectedRole}" BorderThickness="0"
                                 VirtualizingPanel.IsVirtualizing="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="8,6" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Bd" Padding="{TemplateBinding Padding}" CornerRadius="5" Background="Transparent" Margin="0,1">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PanelBrush}" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectionBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type m:SecurityRoleInfo}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Foreground="{DynamicResource MutedTextBrush}" FontSize="11.5" TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding BusinessUnitName, Mode=OneWay}" /> · <Run Text="{Binding ManagedText, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Stretch" Background="Transparent" />

                <!-- Role detail -->
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16,12">
                    <Grid>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Visibility="{Binding HasAnalysis, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                            <TextBlock Text="🛡" FontSize="48" HorizontalAlignment="Center" Foreground="{DynamicResource HintBrush}" />
                            <TextBlock Text="Kết nối tới Dynamics 365 và chọn một security role để phân tích" FontSize="15"
                                       Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center" Margin="0,8,0,0" />
                        </StackPanel>

                        <DockPanel Visibility="{Binding HasAnalysis, Converter={StaticResource BoolToVisibility}}">
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                    <Button x:Name="RoleActionsButton" Content="⚙ Role ▾" Click="OnRoleActionsClick"
                                            ToolTip="Tạo, đổi tên, xóa, xuất/nhập định nghĩa role">
                                        <Button.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="＋ Tạo role mới (rỗng)" Command="{Binding NewRoleCommand}" />
                                                <MenuItem Header="⧉ Sao chép role này" Command="{Binding CopyRoleCommand}" />
                                                <MenuItem Header="✎ Đổi tên role" Command="{Binding RenameRoleCommand}" />
                                                <Separator />
                                                <MenuItem Header="⬆ Xuất định nghĩa role ra file" Command="{Binding ExportRoleDefinitionCommand}" />
                                                <MenuItem Header="⬇ Nhập định nghĩa role từ file" Command="{Binding ImportRoleDefinitionCommand}" />
                                                <Separator />
                                                <MenuItem Header="🗑 Xóa role" Command="{Binding DeleteRoleCommand}" />
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                    </Button>
                                    <Button Content="Mở trong D365" Command="{Binding OpenInBrowserCommand}" />
                                    <Button Content="⟳ Phân tích lại" Command="{Binding ReloadRoleCommand}" />
                                    <Button Content="⬇ Xuất Excel" Command="{Binding ExportCommand}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{Binding Analysis.Role.Name}" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding RoleSubtitle}" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                                </StackPanel>
                            </DockPanel>

                            <TabControl>
                                <!-- Overview -->
                                <TabItem Header="Tổng quan">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel>
                                            <ItemsControl ItemsSource="{Binding SummaryCards}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:SummaryCard}">
                                                        <Border Width="190" Margin="0,0,10,10" Padding="14,10" CornerRadius="8"
                                                                Background="{DynamicResource SubtleBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Title}" Foreground="{DynamicResource MutedTextBrush}" />
                                                                <TextBlock Text="{Binding Value}" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}" />
                                                                <TextBlock Text="{Binding Caption}" FontSize="11.5" Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <Border Background="{DynamicResource WarningBackgroundBrush}" BorderBrush="{DynamicResource WarningBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,10,10"
                                                    Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="{Binding WarningsText}" TextWrapping="Wrap" Foreground="{DynamicResource WarningTextBrush}" />
                                            </Border>

                                            <TextBlock Text="{Binding FindingsHeader}" Style="{StaticResource SectionTitle}" Margin="0,6,0,8" />
                                            <ItemsControl ItemsSource="{Binding Analysis.Findings}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type m:AnalysisFinding}">
                                                        <Border Margin="0,0,10,8" Padding="12,8" CornerRadius="6" BorderThickness="4,1,1,1"
                                                                BorderBrush="{Binding Severity, Converter={StaticResource SeverityBrush}}" Background="{DynamicResource SurfaceBrush}">
                                                            <StackPanel>
                                                                <TextBlock>
                                                                    <Run Text="{Binding SeverityText, Mode=OneWay}" FontWeight="Bold"
                                                                         Foreground="{Binding Severity, Converter={StaticResource SeverityBrush}}" />
                                                                    <Run Text="  " />
                                                                    <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" />
                                                                </TextBlock>
                                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" Margin="0,3,0,0" />
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <TextBlock Text="Component theo loại" Style="{StaticResource SectionTitle}" Margin="0,10,0,8" />
                                            <DataGrid ItemsSource="{Binding ComponentSummary}" HorizontalAlignment="Left" Width="520" Margin="0,0,0,10"
                                                      VerticalScrollBarVisibility="Disabled">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Loại component" Binding="{Binding Category}" Width="*" />
                                                    <DataGridTextColumn Header="Truy cập được" Binding="{Binding Total}" Width="120" />
                                                    <DataGridTextColumn Header="Gán trực tiếp" Binding="{Binding Direct}" Width="120" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </StackPanel>
                                    </ScrollViewer>
                                </TabItem>

                                <!-- Entity privileges -->
                                <TabItem Header="{Binding EntityTabHeader}">
                                    <DockPanel>
                                        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                            <TextBox Style="{StaticResource SearchBox}" Tag="🔍 Tìm entity (tên hiển thị / logical name)..." Width="300"
                                                     Text="{Binding EntitySearchText, UpdateSourceTrigger=PropertyChanged}" />
                                            <CheckBox Content="Chỉ entity có quyền" IsChecked="{Binding OnlyGrantedEntities}" />
                                            <CheckBox Content="Chỉ entity custom" IsChecked="{Binding OnlyCustomEntities}" />
                                            <Button Content="{Binding EditButtonText}" Command="{Binding ToggleEditPrivilegesCommand}" Margin="16,0,0,0" />
                                        </WrapPanel>
                                        <Border DockPanel.Dock="Top" Style="{StaticResource WarningBanner}"
                                                Visibility="{Binding IsEditingPrivileges, Converter={StaticResource BoolToVisibility}}">
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                    <Button Content="↶ Hủy thay đổi" Command="{Binding DiscardPrivilegesCommand}" />
                                                    <Button Content="💾 Lưu thay đổi" Command="{Binding SavePrivilegesCommand}" Style="{StaticResource PrimaryButton}" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding PendingChangesText}" Foreground="{DynamicResource WarningTextBrush}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                                            </DockPanel>
                                        </Border>
                                        <Border DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                            <TextBlock Foreground="{DynamicResource MutedTextBrush}">
                                                <Run Text="○" FontFamily="Segoe UI Symbol" Foreground="{Binding Source={x:Static m:PrivilegeDepth.None}, Converter={StaticResource DepthBrush}, Mode=OneWay}" FontSize="15" /> None
                                                <Run Text="     ◔" FontFamily="Segoe UI Symbol" Foreground="{Binding Source={x:Static m:PrivilegeDepth.User}, Converter={StaticResource DepthBrush}, Mode=OneWay}" FontSize="15" /> User
                                                <Run Text="     ◑" FontFamily="Segoe UI Symbol" Foreground="{Binding Source={x:Static m:PrivilegeDepth.BusinessUnit}, Converter={StaticResource DepthBrush}, Mode=OneWay}" FontSize="15" /> Business Unit
                                                <Run Text="     ◕" FontFamily="Segoe UI Symbol" Foreground="{Binding Source={x:Static m:PrivilegeDepth.ParentChild}, Converter={StaticResource DepthBrush}, Mode=OneWay}" FontSize="15" /> Parent: Child BU
                                                <Run Text="     ●" FontFamily="Segoe UI Symbol" Foreground="{Binding Source={x:Static m:PrivilegeDepth.Organization}, Converter={StaticResource DepthBrush}, Mode=OneWay}" FontSize="15" /> Organization
                                                <Run Text="     –" FontFamily="Segoe UI Symbol" FontSize="15" /> Không áp dụng   ·   Rê chuột lên ô để xem tên privilege
                                            </TextBlock>
                                        </Border>
                                        <DataGrid ItemsSource="{Binding EntityRowsView}" FrozenColumnCount="2">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Entity" Binding="{Binding DisplayName}" Width="220" />
                                                <DataGridTextColumn Header="Logical Name" Binding="{Binding LogicalName}" Width="200" />
                                                <c:DepthColumn Header="Create" CellPath="Create" />
                                                <c:DepthColumn Header="Read" CellPath="Read" />
                                                <c:DepthColumn Header="Write" CellPath="Write" />
                                                <c:DepthColumn Header="Delete" CellPath="Delete" />
                                                <c:DepthColumn Header="Append" CellPath="Append" />
                                                <c:DepthColumn Header="Append To" CellPath="AppendTo" Width="80" />
                                                <c:DepthColumn Header="Assign" CellPath="Assign" />
                                                <c:DepthColumn Header="Share" CellPath="Share" />
                                                <DataGridCheckBoxColumn Header="Custom" Binding="{Binding IsCustom, Mode=OneWay}" Width="70" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </DockPanel>
                                </TabItem>

                                <!-- Misc privileges -->
                                <TabItem Header="{Binding MiscTabHeader}">
                                    <DockPanel>
                                        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                            <TextBox Style="{StaticResource SearchBox}" Tag="🔍 Tìm privilege..." Width="300"
                                                     Text="{Binding MiscSearchText, UpdateSourceTrigger=PropertyChanged}" />
                                            <CheckBox Content="Chỉ privilege được cấp" IsChecked="{Binding OnlyGrantedMisc}" />
                                            <Button Content="{Binding EditButtonText}" Command="{Binding ToggleEditPrivilegesCommand}" Margin="16,0,0,0" />
                                        </WrapPanel>
                                        <Border DockPanel.Dock="Top" Style="{StaticResource WarningBanner}"
                                                Visibility="{Binding IsEditingPrivileges, Converter={StaticResource BoolToVisibility}}">
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                    <Button Content="↶ Hủy thay đổi" Command="{Binding DiscardPrivilegesCommand}" />
                                                    <Button Content="💾 Lưu thay đổi" Command="{Binding SavePrivilegesCommand}" Style="{StaticResource PrimaryButton}" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding PendingChangesText}" Foreground="{DynamicResource WarningTextBrush}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                                            </DockPanel>
                                        </Border>
                                        <DataGrid ItemsSource="{Binding MiscView}">
                                            <DataGrid.Columns>
                                                <c:DepthColumn Header="" CellPath="Depth" IsPrivilegeCell="False" ChangedPath="IsChanged" Width="40" />
                                                <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Privilege" Binding="{Binding Name}" Width="320" />
                                                <DataGridTextColumn Header="Mức" Binding="{Binding DepthText}" Width="150" />
                                                <DataGridTextColumn Header="Entity" Binding="{Binding Entity}" Width="180" />
                                                <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Các mức cho phép" Binding="{Binding AllowedDepths}" Width="*" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </DockPanel>
                                </TabItem>

                                <!-- Users -->
                                <TabItem Header="{Binding UsersTabHeader}">
                                    <DockPanel>
                                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                <Button Content="＋ Thêm user" Command="{Binding AddUserCommand}" Style="{StaticResource PrimaryButton}" />
                                                <Button Content="Gỡ user đã chọn" Command="{Binding RemoveUsersCommand}" Style="{StaticResource DangerButton}" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBox Style="{StaticResource SearchBox}" Tag="🔍 Tìm user / username / business unit..." Width="320"
                                                         Text="{Binding UserSearchText, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock Text="{Binding SelectedUsersText}" Foreground="{DynamicResource PrimaryBrush}" FontWeight="SemiBold"
                                                           VerticalAlignment="Center" Margin="12,0,0,0" />
                                            </StackPanel>
                                        </DockPanel>
                                        <DataGrid x:Name="RoleUsersGrid" ItemsSource="{Binding UsersView}" SelectionMode="Extended" ToolTip="Double-click để mở user"
                                                  c:GridSelection.Enabled="True" c:GridSelection.SelectedItems="{Binding SelectedUsers, Mode=OneWayToSource}">
                                            <DataGrid.InputBindings>
                                                <MouseBinding Gesture="LeftDoubleClick" Command="{Binding OpenRoleUserCommand}"
                                                              CommandParameter="{Binding CurrentItem, ElementName=RoleUsersGrid}" />
                                            </DataGrid.InputBindings>
                                            <DataGrid.Columns>
                                                <c:SelectColumn />
                                                <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Họ tên" Binding="{Binding FullName}" Width="220" />
                                                <DataGridTextColumn Header="Username" Binding="{Binding DomainName}" Width="240" />
                                                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="220" />
                                                <DataGridTextColumn Header="Business Unit" Binding="{Binding BusinessUnitName}" Width="180" />
                                                <DataGridTextColumn Header="Trạng thái" Binding="{Binding StatusText}" Width="90" />
                                                <DataGridCheckBoxColumn Header="Cũng qua team" Binding="{Binding AlsoViaTeam, Mode=OneWay}" Width="*" MinWidth="100" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </DockPanel>
                                </TabItem>

                                <!-- Teams -->
                                <TabItem Header="{Binding TeamsTabHeader}">
                                    <DockPanel>
                                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                <Button Content="＋ Thêm team" Command="{Binding AddTeamCommand}" Style="{StaticResource PrimaryButton}" />
                                                <Button Content="Gỡ team đã chọn" Command="{Binding RemoveTeamsCommand}" Style="{StaticResource DangerButton}" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBox Style="{StaticResource SearchBox}" Tag="🔍 Tìm team..." Width="320"
                                                         Text="{Binding TeamSearchText, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock Text="{Binding SelectedTeamsText}" Foreground="{DynamicResource PrimaryBrush}" FontWeight="SemiBold"
                                                           VerticalAlignment="Center" Margin="12,0,0,0" />
                                            </StackPanel>
                                        </DockPanel>
                                        <DataGrid x:Name="RoleTeamsGrid" ItemsSource="{Binding TeamsView}" SelectionMode="Extended"
                                                  c:GridSelection.Enabled="True" c:GridSelection.SelectedItems="{Binding SelectedTeams, Mode=OneWayToSource}"
                                                  ToolTip="Double-click để mở team trong chế độ Teams">
                                            <DataGrid.InputBindings>
                                                <MouseBinding Gesture="LeftDoubleClick" Command="{Binding OpenRoleTeamCommand}"
                                                              CommandParameter="{Binding CurrentItem, ElementName=RoleTeamsGrid}" />
                                            </DataGrid.InputBindings>
                                            <DataGrid.Columns>
                                                <c:SelectColumn />
                                                <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Team" Binding="{Binding Name}" Width="280" />
                                                <DataGridTextColumn Header="Loại team" Binding="{Binding TeamTypeText}" Width="180" />
                                                <DataGridTextColumn Header="Business Unit" Binding="{Binding BusinessUnitName}" Width="220" />
                                                <DataGridCheckBoxColumn Header="Default team" Binding="{Binding IsDefault, Mode=OneWay}" Width="100" />
                                                <DataGridTextColumn Header="Số thành viên" Binding="{Binding MemberCount}" Width="*" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </DockPanel>
                                </TabItem>

                                <!-- Users via teams -->
                                <TabItem Header="{Binding TeamUsersTabHeader}">
                                    <DockPanel>
                                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Muted}" VerticalAlignment="Center"
                                                       Text="User là thành viên của team được gán role → nhận quyền của role một cách gián tiếp." />
                                            <TextBox Style="{StaticResource SearchBox}" Tag="🔍 Tìm user / team..." Width="320" HorizontalAlignment="Left"
                                                     Text="{Binding TeamUserSearchText, UpdateSourceTrigger=PropertyChanged}" />
                                        </DockPanel>
                                        <DataGrid x:Name="RoleTeamUsersGrid" ItemsSource="{Binding TeamUsersView}" ToolTip="Double-click để mở user">
                                            <DataGrid.InputBindings>
                                                <MouseBinding Gesture="LeftDoubleClick" Command="{Binding OpenRoleUserCommand}"
                                                              CommandParameter="{Binding CurrentItem, ElementName=RoleTeamUsersGrid}" />
                                            </DataGrid.InputBindings>
                                            <DataGrid.Columns>
                                                <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Họ tên" Binding="{Binding FullName}" Width="220" />
                                                <DataGridTextColumn Header="Username" Binding="{Binding DomainName}" Width="240" />
                                                <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Qua team" Binding="{Binding TeamName}" Width="220" />
                                                <DataGridTextColumn Header="Business Unit" Binding="{Binding BusinessUnitName}" Width="180" />
                                                <DataGridTextColumn Header="Trạng thái" Binding="{Binding StatusText}" Width="90" />
                                                <DataGridCheckBoxColumn Header="Cũng gán trực tiếp" Binding="{Binding AlsoDirect, Mode=OneWay}" Width="*" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </DockPanel>
                                </TabItem>

                                <!-- Components -->
                                <TabItem Header="{Binding ComponentsTabHeader}">
                                    <DockPanel>
                                        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                            <ComboBox ItemsSource="{Binding ComponentCategories}" SelectedItem="{Binding ComponentCategoryFilter}" Width="200" />
                                            <TextBox Style="{StaticResource SearchBox}" Tag="🔍 Tìm theo tên component / entity..." Width="300" Margin="8,0,0,0"
                                                     Text="{Binding ComponentSearchText, UpdateSourceTrigger=PropertyChanged}" />
                                            <CheckBox Content="Chỉ component gán trực tiếp cho role" IsChecked="{Binding OnlyDirectComponents}" />
                                        </WrapPanel>
                                        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Muted}" Margin="0,8,0,0"
                                                   Text="App, Form, Dashboard có thể gán trực tiếp cho role. View, Chart không phân quyền theo role nên được suy ra từ quyền Read entity. BPF được xác định qua privilege trên entity của BPF; Custom API qua Execute Privilege." />
                                        <DataGrid ItemsSource="{Binding ComponentsView}">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Loại" Binding="{Binding Category}" Width="130" />
                                                <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Tên" Binding="{Binding Name}" Width="*" />
                                                <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Entity" Binding="{Binding EntityDisplayName}" Width="120" />
                                                <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Gán" Binding="{Binding AssignmentText}" Width="130" />
                                                <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Lý do truy cập" Binding="{Binding AccessReason}" Width="1.6*" />
                                                <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Kiểu" Binding="{Binding SubType}" Width="120" />
                                                <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Trạng thái" Binding="{Binding State}" Width="75" />
                                                <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Managed" Binding="{Binding ManagedText}" Width="85" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </DockPanel>
                                </TabItem>
                            </TabControl>
                        </DockPanel>
                    </Grid>
                </Border>
            </Grid>
            </Grid>
        </DockPanel>

        <!-- Busy overlay -->
        <Grid Background="{DynamicResource OverlayBrush}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
            <Border Style="{StaticResource Card}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28,20" MinWidth="360">
                <StackPanel>
                    <TextBlock Text="{Binding BusyText}" FontSize="14" HorizontalAlignment="Center" TextWrapping="Wrap" />
                    <ProgressBar Height="6" Margin="0,14,0,0" Minimum="0" Maximum="100" Value="{Binding BusyProgress, Mode=OneWay}"
                                 IsIndeterminate="{Binding HasProgressValue, Converter={StaticResource InverseBool}}" />
                    <TextBlock Text="{Binding ProgressText}" HorizontalAlignment="Center" Margin="0,6,0,0"
                               Foreground="{DynamicResource MutedTextBrush}"
                               Visibility="{Binding HasProgressValue, Converter={StaticResource BoolToVisibility}}" />
                    <Button Content="Hủy" Command="{Binding CancelBusyCommand}" HorizontalAlignment="Center" Margin="0,12,0,0" MinWidth="100"
                            Visibility="{Binding CanCancelBusy, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
