<Window x:Class="SecurityRoleAnalyzer.Views.AccessReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SecurityRoleAnalyzer.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:AccessReviewViewModel}"
        Title="Rà soát quyền toàn hệ thống (User × Role)" Width="1350" Height="820" WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" FontSize="13" Background="{DynamicResource AppBackgroundBrush}">
    <Grid>
        <Border Style="{StaticResource Card}" Margin="12">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="⟳ Tải lại" Command="{Binding LoadCommand}" />
                        <Button Content="⬇ Xuất Excel (kèm ma trận User × Role)" Command="{Binding ExportCommand}" Style="{StaticResource PrimaryButton}" />
                    </StackPanel>
                    <TextBox Style="{StaticResource SearchBox}" Tag="🔍 Tìm user, username, BU hoặc tên role..." Width="360" HorizontalAlignment="Left"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                </DockPanel>
                <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding SummaryCards}" Style="{StaticResource SummaryCards}" />
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusText}" Style="{StaticResource Muted}" Margin="0,8,0,0" />
                <TabControl>
                    <TabItem Header="Users">
                        <DockPanel>
                            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <CheckBox Content="Chỉ user có cảnh báo" IsChecked="{Binding OnlyIssues}" Margin="0" />
                                <CheckBox Content="Chỉ System Administrator" IsChecked="{Binding OnlySystemAdministrators}" />
                                <CheckBox Content="Ẩn user disabled (trừ khi còn role)" IsChecked="{Binding HideDisabled}" />
                            </WrapPanel>
                            <DataGrid x:Name="UsersGrid" ItemsSource="{Binding UsersView}" ToolTip="Double-click để mở user">
                                <DataGrid.InputBindings>
                                    <MouseBinding Gesture="LeftDoubleClick" Command="{Binding OpenUserCommand}" CommandParameter="{Binding CurrentItem, ElementName=UsersGrid}" />
                                </DataGrid.InputBindings>
                                <DataGrid.Columns>
                                    <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Họ tên" Binding="{Binding User.FullName}" Width="180" />
                                    <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Username" Binding="{Binding User.DomainName}" Width="190" />
                                    <DataGridTextColumn Header="BU" Binding="{Binding User.BusinessUnitName}" Width="110" />
                                    <DataGridTextColumn Header="Trạng thái" Binding="{Binding User.StatusText}" Width="80" />
                                    <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Role trực tiếp" Binding="{Binding DirectRoles}" Width="*" />
                                    <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Role qua team" Binding="{Binding TeamRoles}" Width="*" />
                                    <DataGridTextColumn Header="Hiệu lực" Binding="{Binding EffectiveRoleCount}" Width="70" />
                                    <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Cảnh báo" Binding="{Binding Flags}" Width="200">
                                        <DataGridTextColumn.CellStyle>
                                            <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                            </Style>
                                        </DataGridTextColumn.CellStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="Roles">
                        <DockPanel>
                            <CheckBox DockPanel.Dock="Top" Content="Chỉ role không được sử dụng" IsChecked="{Binding OnlyUnusedRoles}" Margin="0,0,0,8" HorizontalAlignment="Left" />
                            <DataGrid x:Name="RolesGrid" ItemsSource="{Binding RolesView}" ToolTip="Double-click để mở role">
                                <DataGrid.InputBindings>
                                    <MouseBinding Gesture="LeftDoubleClick" Command="{Binding OpenRoleCommand}" CommandParameter="{Binding CurrentItem, ElementName=RolesGrid}" />
                                </DataGrid.InputBindings>
                                <DataGrid.Columns>
                                    <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Role" Binding="{Binding Role.Name}" Width="*" />
                                    <DataGridTextColumn Header="Managed" Binding="{Binding Role.ManagedText}" Width="100" />
                                    <DataGridTextColumn Header="User trực tiếp" Binding="{Binding DirectUserCount}" Width="110" />
                                    <DataGridTextColumn Header="Team" Binding="{Binding TeamCount}" Width="70" />
                                    <DataGridTextColumn Header="User hiệu lực" Binding="{Binding EffectiveUserCount}" Width="110" />
                                    <DataGridTextColumn Header="Trong đó disabled" Binding="{Binding DisabledUserCount}" Width="130" />
                                    <DataGridCheckBoxColumn Header="Không dùng" Binding="{Binding IsUnused, Mode=OneWay}" Width="100" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </DockPanel>
        </Border>

        <Grid Background="{DynamicResource OverlayBrush}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
            <Border Style="{StaticResource Card}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28,20" MinWidth="360">
                <StackPanel>
                    <TextBlock Text="{Binding BusyText}" HorizontalAlignment="Center" TextWrapping="Wrap" />
                    <ProgressBar IsIndeterminate="True" Height="4" Margin="0,14,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
