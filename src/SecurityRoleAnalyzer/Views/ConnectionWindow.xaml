<Window x:Class="SecurityRoleAnalyzer.Views.ConnectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kết nối Dynamics 365 / Dataverse" Width="600" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="13" Background="{StaticResource SurfaceBrush}">
    <StackPanel Margin="20">
        <TextBlock Text="Kết nối tới môi trường" Style="{StaticResource SectionTitle}" FontSize="17" />

        <TextBlock Text="Phương thức xác thực" Margin="0,4,0,4" />
        <ComboBox x:Name="AuthTypeBox" SelectionChanged="OnAuthTypeChanged">
            <ComboBoxItem Content="Đăng nhập tương tác (OAuth / Microsoft Entra ID, hỗ trợ MFA)" Tag="OAuthInteractive" IsSelected="True" />
            <ComboBoxItem Content="Application User (Client Id + Client Secret)" Tag="ClientSecret" />
            <ComboBoxItem Content="Connection string tùy chỉnh" Tag="ConnectionString" />
        </ComboBox>

        <TextBlock Text="Tên hiển thị (tùy chọn, ví dụ PROD / UAT)" Margin="0,12,0,4" />
        <TextBox x:Name="NameBox" />

        <StackPanel x:Name="UrlPanel">
            <TextBlock Text="URL môi trường" Margin="0,12,0,4" />
            <ComboBox x:Name="UrlBox" IsEditable="True" DisplayMemberPath="DisplayName" SelectionChanged="OnProfileSelected"
                      ToolTip="Ví dụ: https://contoso.crm5.dynamics.com" />
            <TextBlock Text="Ví dụ: https://tenorg.crm5.dynamics.com" Style="{StaticResource Muted}" FontSize="11.5" Margin="0,3,0,0" />
        </StackPanel>

        <StackPanel x:Name="OAuthPanel">
            <TextBlock Text="Tài khoản (tùy chọn – gợi ý đăng nhập)" Margin="0,12,0,4" />
            <TextBox x:Name="UserNameBox" />
            <Expander Header="Nâng cao (App Id / Redirect Uri)" Margin="0,10,0,0">
                <StackPanel Margin="0,6,0,0">
                    <TextBlock Text="App Id" Margin="0,0,0,4" />
                    <TextBox x:Name="AppIdBox" />
                    <TextBlock Text="Redirect Uri" Margin="0,8,0,4" />
                    <TextBox x:Name="RedirectUriBox" />
                </StackPanel>
            </Expander>
        </StackPanel>

        <StackPanel x:Name="SecretPanel" Visibility="Collapsed">
            <TextBlock Text="Client Id (Application Id)" Margin="0,12,0,4" />
            <TextBox x:Name="ClientIdBox" />
            <TextBlock Text="Client Secret" Margin="0,10,0,4" />
            <PasswordBox x:Name="SecretBox" />
            <CheckBox x:Name="SaveSecretBox" Content="Lưu client secret (mã hóa theo tài khoản Windows hiện tại) để kết nối nhanh" Margin="0,6,0,0" />
        </StackPanel>

        <StackPanel x:Name="ConnectionStringPanel" Visibility="Collapsed">
            <TextBlock Text="Connection string" Margin="0,12,0,4" />
            <TextBox x:Name="ConnectionStringBox" Height="90" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"
                     FontFamily="Consolas" />
            <TextBlock Style="{StaticResource Muted}" FontSize="11.5" Margin="0,3,0,0"
                       Text="Ví dụ: AuthType=Certificate;Url=https://org.crm.dynamics.com;ClientId=...;Thumbprint=..." />
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Hủy" IsCancel="True" MinWidth="90" />
            <Button Content="Kết nối" IsDefault="True" Click="OnConnect" MinWidth="110" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
