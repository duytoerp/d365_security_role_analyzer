<UserControl x:Class="SecurityRoleAnalyzer.Views.FieldSecurityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SecurityRoleAnalyzer.ViewModels"
             xmlns:m="clr-namespace:SecurityRoleAnalyzer.Models"
             xmlns:c="clr-namespace:SecurityRoleAnalyzer.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:FieldSecurityViewModel}"
             FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" MinWidth="220" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource Card}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Field Security Profiles" Style="{StaticResource SectionTitle}" />
                <TextBox DockPanel.Dock="Top" Style="{StaticResource SearchBox}" Tag="🔍 Tìm profile..." Margin="0,0,0,8"
                         Text="{Binding ProfileSearchText, UpdateSourceTrigger=PropertyChanged}" />
                <ListBox ItemsSource="{Binding ProfilesView}" SelectedItem="{Binding SelectedProfile}" Style="{StaticResource SideList}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type m:FieldSecurityProfileInfo}">
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding ManagedText}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11.5" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Stretch" Background="Transparent" />

        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16,12">
            <Grid>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding HasAnalysis, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                    <TextBlock Text="🔒" FontSize="48" HorizontalAlignment="Center" Foreground="{DynamicResource HintBrush}" />
                    <TextBlock Text="Chọn một Field Security Profile để xem cột được bảo mật và user/team được gán" Style="{StaticResource EmptyHint}" Margin="0,8,0,0" />
                </StackPanel>

                <DockPanel Visibility="{Binding HasAnalysis, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button Content="⟳ Phân tích lại" Command="{Binding ReloadCommand}" />
                            <Button Content="⬇ Xuất Excel" Command="{Binding ExportCommand}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{Binding Analysis.Profile.Name}" Style="{StaticResource DetailTitle}" />
                            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                        </StackPanel>
                    </DockPanel>

                    <TabControl>
                        <TabItem Header="Tổng quan">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <ItemsControl ItemsSource="{Binding SummaryCards}" Style="{StaticResource SummaryCards}" />
                                    <TextBlock Text="{Binding FindingsHeader}" Style="{StaticResource SectionTitle}" Margin="0,6,0,8" />
                                    <ItemsControl ItemsSource="{Binding Analysis.Findings}" Style="{StaticResource Findings}" />
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="{Binding PermissionsTabHeader}">
                            <DockPanel>
                                <TextBox DockPanel.Dock="Top" Style="{StaticResource SearchBox}" Tag="🔍 Tìm entity hoặc cột..." Width="320"
                                         HorizontalAlignment="Left" Margin="0,0,0,8" Text="{Binding PermissionSearchText, UpdateSourceTrigger=PropertyChanged}" />
                                <DataGrid ItemsSource="{Binding PermissionsView}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Entity" Binding="{Binding EntityDisplayName}" Width="200" />
                                        <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Cột" Binding="{Binding AttributeDisplayName}" Width="*" />
                                        <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Logical name" Binding="{Binding Attribute}" Width="200" />
                                        <DataGridTextColumn Header="Read" Binding="{Binding ReadText}" Width="70" />
                                        <DataGridTextColumn Header="Create" Binding="{Binding CreateText}" Width="70" />
                                        <DataGridTextColumn Header="Update" Binding="{Binding UpdateText}" Width="70" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </TabItem>

                        <TabItem Header="{Binding UsersTabHeader}">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Content="＋ Thêm user" Command="{Binding AddUsersCommand}" Style="{StaticResource PrimaryButton}" />
                                        <Button Content="Gỡ user đã chọn" Command="{Binding RemoveUsersCommand}" Style="{StaticResource DangerButton}" />
                                    </StackPanel>
                                    <TextBox Style="{StaticResource SearchBox}" Tag="🔍 Tìm user..." Width="300" HorizontalAlignment="Left"
                                             Text="{Binding UserSearchText, UpdateSourceTrigger=PropertyChanged}" />
                                </DockPanel>
                                <DataGrid x:Name="UsersGrid" ItemsSource="{Binding UsersView}" SelectionMode="Extended" ToolTip="Double-click để mở user"
                                          c:GridSelection.Enabled="True" c:GridSelection.SelectedItems="{Binding SelectedUsers, Mode=OneWayToSource}">
                                    <DataGrid.InputBindings>
                                        <MouseBinding Gesture="LeftDoubleClick" Command="{Binding OpenUserCommand}" CommandParameter="{Binding CurrentItem, ElementName=UsersGrid}" />
                                    </DataGrid.InputBindings>
                                    <DataGrid.Columns>
                                        <c:SelectColumn />
                                        <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Họ tên" Binding="{Binding FullName}" Width="220" />
                                        <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Username" Binding="{Binding DomainName}" Width="*" />
                                        <DataGridTextColumn Header="Business Unit" Binding="{Binding BusinessUnitName}" Width="170" />
                                        <DataGridTextColumn Header="Trạng thái" Binding="{Binding StatusText}" Width="90" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </TabItem>

                        <TabItem Header="{Binding TeamsTabHeader}">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Content="＋ Thêm team" Command="{Binding AddTeamsCommand}" Style="{StaticResource PrimaryButton}" />
                                        <Button Content="Gỡ team đã chọn" Command="{Binding RemoveTeamsCommand}" Style="{StaticResource DangerButton}" />
                                    </StackPanel>
                                    <TextBox Style="{StaticResource SearchBox}" Tag="🔍 Tìm team..." Width="300" HorizontalAlignment="Left"
                                             Text="{Binding TeamSearchText, UpdateSourceTrigger=PropertyChanged}" />
                                </DockPanel>
                                <DataGrid x:Name="TeamsGrid" ItemsSource="{Binding TeamsView}" SelectionMode="Extended" ToolTip="Double-click để mở team"
                                          c:GridSelection.Enabled="True" c:GridSelection.SelectedItems="{Binding SelectedTeams, Mode=OneWayToSource}">
                                    <DataGrid.InputBindings>
                                        <MouseBinding Gesture="LeftDoubleClick" Command="{Binding OpenTeamCommand}" CommandParameter="{Binding CurrentItem, ElementName=TeamsGrid}" />
                                    </DataGrid.InputBindings>
                                    <DataGrid.Columns>
                                        <c:SelectColumn />
                                        <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Team" Binding="{Binding Name}" Width="*" />
                                        <DataGridTextColumn Header="Loại team" Binding="{Binding TeamTypeText}" Width="180" />
                                        <DataGridTextColumn Header="Business Unit" Binding="{Binding BusinessUnitName}" Width="170" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </TabItem>

                        <TabItem Header="{Binding EffectiveTabHeader}">
                            <DockPanel>
                            <TextBox DockPanel.Dock="Top" Style="{StaticResource SearchBox}" Tag="🔍 Tìm user hoặc nguồn..." Width="320"
                                     HorizontalAlignment="Left" Margin="0,0,0,8"
                                     Text="{Binding EffectiveSearchText, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGrid x:Name="EffectiveGrid" ItemsSource="{Binding EffectiveView}" ToolTip="Double-click để mở user">
                                <DataGrid.InputBindings>
                                    <MouseBinding Gesture="LeftDoubleClick" Command="{Binding OpenUserCommand}" CommandParameter="{Binding CurrentItem, ElementName=EffectiveGrid}" />
                                </DataGrid.InputBindings>
                                <DataGrid.Columns>
                                    <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Họ tên" Binding="{Binding Name}" Width="220" />
                                    <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Username" Binding="{Binding Detail}" Width="240" />
                                    <DataGridTextColumn Header="Business Unit" Binding="{Binding BusinessUnitName}" Width="160" />
                                    <DataGridTextColumn Header="Trạng thái" Binding="{Binding StatusText}" Width="90" />
                                    <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Nguồn" Binding="{Binding Via}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                            </DockPanel>
                        </TabItem>
                    </TabControl>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
