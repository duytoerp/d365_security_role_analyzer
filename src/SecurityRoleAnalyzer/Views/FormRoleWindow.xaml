<Window x:Class="SecurityRoleAnalyzer.Views.FormRoleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SecurityRoleAnalyzer.ViewModels"
        xmlns:c="clr-namespace:SecurityRoleAnalyzer.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:FormRoleViewModel}"
        Title="Form mở cho role nào" Width="1320" Height="800" WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" FontSize="13" Background="{DynamicResource AppBackgroundBrush}">
    <Grid>
        <Border Style="{StaticResource Card}" Margin="12">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource InfoBanner}">
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource InfoTextBrush}"
                               Text="Đọc từ systemform.displayconditions – đúng nội dung Form settings → Security roles trong D365. Chọn một form để xem danh sách role, hoặc lọc theo role để biết role đó thấy được những form nào." />
                </Border>

                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Button Content="⟳ Tải lại" Command="{Binding LoadCommand}" Style="{StaticResource PrimaryButton}" />
                    <TextBox Style="{StaticResource SearchBox}" Tag="🔍 Tìm form hoặc entity..." Width="260" Margin="12,0,0,0"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Role:" VerticalAlignment="Center" Margin="12,0,6,0" />
                    <ComboBox ItemsSource="{Binding RoleOptions}" SelectedItem="{Binding RoleFilter}"
                              DisplayMemberPath="Name" Width="240" MaxDropDownHeight="420"
                              ToolTip="Chọn một role để chỉ xem những form role đó được gán" />
                    <ComboBox ItemsSource="{Binding VisibilityOptions}" SelectedItem="{Binding VisibilityFilter}"
                              Width="240" Margin="12,0,0,0" />
                    <CheckBox Content="Chỉ form đang bật" IsChecked="{Binding OnlyActive}" />
                    <Button Content="⬇ Xuất Excel" Command="{Binding ExportCommand}" Margin="12,0,0,0" />
                </WrapPanel>

                <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding SummaryCards}" Style="{StaticResource SummaryCards}" />
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusText}" Style="{StaticResource Muted}" Margin="0,8,0,0" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="420" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="420" MinWidth="280" />
                    </Grid.ColumnDefinitions>

                    <DataGrid x:Name="FormsGrid" ItemsSource="{Binding RowsView}"
                              SelectedItem="{Binding SelectedRow}" ToolTip="Chọn một form để xem danh sách role bên phải">
                        <DataGrid.Columns>
                            <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Entity" Binding="{Binding EntityText}" Width="150" />
                            <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Form" Binding="{Binding FormName}" Width="*" />
                            <DataGridTextColumn Header="Kiểu" Binding="{Binding FormTypeText}" Width="120" />
                            <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Phân quyền" Binding="{Binding VisibilityText}" Width="140" />
                            <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Role được gán" Binding="{Binding RolesText}" Width="1.4*" />
                            <DataGridTextColumn Header="Managed" Binding="{Binding ManagedText}" Width="100" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Stretch" Background="Transparent" />

                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14,12">
                        <Grid>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                        Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                                <TextBlock Text="🧾" FontSize="42" HorizontalAlignment="Center" Foreground="{DynamicResource HintBrush}" />
                                <TextBlock Text="Chọn một form ở bảng bên trái để xem những security role được cấu hình thấy form đó"
                                           Style="{StaticResource EmptyHint}" Margin="0,8,0,0" />
                            </StackPanel>

                            <DockPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock DockPanel.Dock="Top" Text="{Binding SelectedTitle}" Style="{StaticResource DetailTitle}" TextWrapping="Wrap" />
                                <TextBlock DockPanel.Dock="Top" Text="{Binding SelectedSubtitle}" Style="{StaticResource Muted}" Margin="0,2,0,8" />
                                <Border DockPanel.Dock="Top" Style="{StaticResource WarningBanner}" Margin="0,0,0,8"
                                        Visibility="{Binding HintIsWarning, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding SelectedHint}" TextWrapping="Wrap"
                                               Foreground="{DynamicResource WarningTextBrush}" LineHeight="20" />
                                </Border>
                                <Border DockPanel.Dock="Top" Style="{StaticResource InfoBanner}" Margin="0,0,0,8"
                                        Visibility="{Binding HintIsInfo, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding SelectedHint}" TextWrapping="Wrap"
                                               Foreground="{DynamicResource InfoTextBrush}" LineHeight="20" />
                                </Border>
                                <TextBlock DockPanel.Dock="Top" Text="Security role được gán" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />
                                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                    <Button Content="＋ Thêm role" Command="{Binding AddRolesCommand}" Style="{StaticResource PrimaryButton}"
                                            ToolTip="Chọn thêm security role được thấy form này (lưu và publish ngay)" />
                                    <Button Content="Gỡ role đã chọn" Command="{Binding RemoveRolesCommand}" Style="{StaticResource DangerButton}"
                                            ToolTip="Chọn một hoặc nhiều role ở bảng dưới rồi bấm để gỡ" />
                                    <Button Content="Mở cho mọi role" Command="{Binding OpenToEveryoneCommand}"
                                            ToolTip="Chuyển form sang Everyone – mọi user đọc được entity đều thấy form" />
                                </WrapPanel>
                                <TextBlock DockPanel.Dock="Top" Text="{Binding EditHint}" Style="{StaticResource Muted}" Margin="0,0,0,6"
                                           TextWrapping="Wrap" Visibility="{Binding CanEditRoles, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                                <TextBlock DockPanel.Dock="Top" Text="{Binding SelectedRolesText}" Style="{StaticResource SelectionText}" Margin="0,0,0,6" />
                                <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                                    <TextBlock DockPanel.Dock="Top" Text="{Binding HistoryTitle}" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />
                                    <DataGrid ItemsSource="{Binding SelectedHistory}" Height="210" RowDetailsVisibilityMode="VisibleWhenSelected"
                                              ToolTip="Chọn một dòng để xem trạng thái trước/sau. Hoàn tác trong 🧰 Công cụ → Lịch sử thao tác">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Thời gian" Binding="{Binding Time, StringFormat=dd/MM/yy HH:mm}" Width="105" />
                                            <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Thao tác" Binding="{Binding Action}" Width="*" />
                                            <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Kết quả" Binding="{Binding ResultText}" Width="95" />
                                        </DataGrid.Columns>
                                        <DataGrid.RowDetailsTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="8,4,8,8">
                                                    <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" />
                                                    <TextBlock TextWrapping="Wrap" Margin="0,4,0,0">
                                                        <Run Text="Trước: " FontWeight="SemiBold" /><Run Text="{Binding Before, Mode=OneWay}" />
                                                    </TextBlock>
                                                    <TextBlock TextWrapping="Wrap">
                                                        <Run Text="Sau: " FontWeight="SemiBold" /><Run Text="{Binding After, Mode=OneWay}" />
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Foreground="{DynamicResource WarningTextBrush}" />
                                                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0">
                                                        <Run Text="{Binding Operator, Mode=OneWay}" /><Run Text=" · sao lưu: " /><Run Text="{Binding BackupFile, Mode=OneWay}" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGrid.RowDetailsTemplate>
                                    </DataGrid>
                                </DockPanel>
                                <DataGrid x:Name="RolesGrid" ItemsSource="{Binding SelectedRoles}" ToolTip="Double-click để mở role"
                                          SelectionMode="Extended" c:GridSelection.Enabled="True"
                                          c:GridSelection.SelectedItems="{Binding SelectedRoleItems, Mode=OneWayToSource}">
                                    <DataGrid.InputBindings>
                                        <MouseBinding Gesture="LeftDoubleClick" Command="{Binding OpenRoleCommand}"
                                                      CommandParameter="{Binding CurrentItem, ElementName=RolesGrid}" />
                                    </DataGrid.InputBindings>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Security Role" Binding="{Binding DisplayName}" Width="*" />
                                        <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Business Unit" Binding="{Binding BusinessUnitText}" Width="150" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Grid>
                    </Border>
                </Grid>
            </DockPanel>
        </Border>

        <Grid Background="{DynamicResource OverlayBrush}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
            <Border Style="{StaticResource Card}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28,20" MinWidth="360">
                <StackPanel>
                    <TextBlock Text="{Binding BusyText}" HorizontalAlignment="Center" TextWrapping="Wrap" />
                    <ProgressBar IsIndeterminate="True" Height="4" Margin="0,14,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
