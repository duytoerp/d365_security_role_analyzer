<UserControl x:Class="SecurityRoleAnalyzer.Views.UsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SecurityRoleAnalyzer.ViewModels"
             xmlns:m="clr-namespace:SecurityRoleAnalyzer.Models"
             xmlns:c="clr-namespace:SecurityRoleAnalyzer.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:UserManagerViewModel}"
             FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" MinWidth="220" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource Card}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Users" Style="{StaticResource SectionTitle}" />
                <TextBox DockPanel.Dock="Top" Style="{StaticResource SearchBox}" Tag="🔍 Tìm tên, username, business unit..."
                         Text="{Binding UserSearchText, UpdateSourceTrigger=PropertyChanged}" />
                <StackPanel DockPanel.Dock="Top" Margin="0,8">
                    <CheckBox Content="Ẩn user disabled" IsChecked="{Binding HideDisabled}" Margin="0" />
                    <DockPanel Margin="0,4,0,0">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding UserCountText}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                        <CheckBox Content="Ẩn application user" IsChecked="{Binding HideApplicationUsers}" Margin="0" />
                    </DockPanel>
                </StackPanel>
                <ListBox ItemsSource="{Binding UsersView}" SelectedItem="{Binding SelectedUser}" Style="{StaticResource SideList}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type m:UserInfo}">
                            <StackPanel>
                                <TextBlock Text="{Binding FullName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding ListCaption}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Stretch" Background="Transparent" />

        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16,12">
            <Grid>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding HasAnalysis, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                    <TextBlock Text="👤" FontSize="48" HorizontalAlignment="Center" Foreground="{DynamicResource HintBrush}" />
                    <TextBlock Text="Chọn một user để xem role (trực tiếp + qua team), quyền hiệu lực và sao chép quyền" Style="{StaticResource EmptyHint}" Margin="0,8,0,0" />
                </StackPanel>

                <DockPanel Visibility="{Binding HasAnalysis, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Top" HorizontalAlignment="Right" MaxWidth="560">
                            <Button Content="⇉ Sao chép quyền sang..." Command="{Binding CopyAccessToCommand}" Margin="4,0,0,4" />
                            <Button Content="⇇ Lấy quyền từ user khác" Command="{Binding CopyAccessFromCommand}" Margin="4,0,0,4" />
                            <Button Content="Mở trong D365" Command="{Binding OpenInBrowserCommand}" Margin="4,0,0,4" />
                            <Button Content="⟳ Phân tích lại" Command="{Binding ReloadCommand}" Margin="4,0,0,4" />
                            <Button Content="⬇ Xuất Excel" Command="{Binding ExportCommand}" Margin="4,0,0,4" />
                        </WrapPanel>
                        <StackPanel>
                            <TextBlock Text="{Binding Analysis.User.FullName}" Style="{StaticResource DetailTitle}" />
                            <TextBlock Text="{Binding UserSubtitle}" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                        </StackPanel>
                    </DockPanel>

                    <TabControl>
                        <TabItem Header="Tổng quan">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <ItemsControl ItemsSource="{Binding SummaryCards}" Style="{StaticResource SummaryCards}" />
                                    <Border Style="{StaticResource WarningBanner}" Margin="0,0,10,10" Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="{Binding WarningsText}" TextWrapping="Wrap" Foreground="{DynamicResource WarningTextBrush}" />
                                    </Border>
                                    <TextBlock Text="{Binding FindingsHeader}" Style="{StaticResource SectionTitle}" Margin="0,6,0,8" />
                                    <ItemsControl ItemsSource="{Binding Analysis.Findings}" Style="{StaticResource Findings}" />
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="{Binding RolesTabHeader}">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Content="＋ Gán role" Command="{Binding AddRolesCommand}" Style="{StaticResource PrimaryButton}" />
                                        <Button Content="Gỡ role đã chọn" Command="{Binding RemoveRolesCommand}" Style="{StaticResource DangerButton}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox Style="{StaticResource SearchBox}" Tag="🔍 Tìm role hoặc nguồn..." Width="300"
                                                 Text="{Binding RoleSearchText, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Text="{Binding SelectedRolesText}" Style="{StaticResource SelectionText}" />
                                    </StackPanel>
                                </DockPanel>
                                <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Muted}" Margin="0,8,0,0"
                                           Text="Role qua team chỉ gỡ được bằng cách gỡ user khỏi team (tab Teams) hoặc gỡ role khỏi team. Double-click để mở role." />
                                <DataGrid x:Name="RolesGrid" ItemsSource="{Binding RolesView}" SelectionMode="Extended"
                                          c:GridSelection.Enabled="True" c:GridSelection.SelectedItems="{Binding SelectedRoles, Mode=OneWayToSource}">
                                    <DataGrid.InputBindings>
                                        <MouseBinding Gesture="LeftDoubleClick" Command="{Binding OpenRoleCommand}" CommandParameter="{Binding CurrentItem, ElementName=RolesGrid}" />
                                    </DataGrid.InputBindings>
                                    <DataGrid.Columns>
                                        <c:SelectColumn />
                                        <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Security Role" Binding="{Binding Name}" Width="*" />
                                        <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Nguồn" Binding="{Binding SourceText}" Width="240" />
                                        <DataGridTextColumn Header="Business Unit" Binding="{Binding BusinessUnitName}" Width="150" />
                                        <DataGridTextColumn Header="Managed" Binding="{Binding ManagedText}" Width="95" />
                                        <DataGridCheckBoxColumn Header="Trùng nguồn" Binding="{Binding IsDuplicated, Mode=OneWay}" Width="95" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </TabItem>

                        <TabItem Header="{Binding TeamsTabHeader}">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Content="＋ Thêm vào team" Command="{Binding AddToTeamsCommand}" Style="{StaticResource PrimaryButton}" />
                                        <Button Content="Gỡ khỏi team đã chọn" Command="{Binding RemoveFromTeamsCommand}" Style="{StaticResource DangerButton}" />
                                    </StackPanel>
                                    <TextBox DockPanel.Dock="Left" Style="{StaticResource SearchBox}" Tag="🔍 Tìm team..." Width="260" Margin="0,0,12,0"
                                             Text="{Binding TeamSearchText, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="{Binding SelectedTeamsText}" Style="{StaticResource SelectionText}" Margin="0" VerticalAlignment="Center" />
                                </DockPanel>
                                <DataGrid x:Name="TeamsGrid" ItemsSource="{Binding TeamsView}" SelectionMode="Extended" ToolTip="Double-click để mở team"
                                          c:GridSelection.Enabled="True" c:GridSelection.SelectedItems="{Binding SelectedTeams, Mode=OneWayToSource}">
                                    <DataGrid.InputBindings>
                                        <MouseBinding Gesture="LeftDoubleClick" Command="{Binding OpenTeamCommand}" CommandParameter="{Binding CurrentItem, ElementName=TeamsGrid}" />
                                    </DataGrid.InputBindings>
                                    <DataGrid.Columns>
                                        <c:SelectColumn />
                                        <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Team" Binding="{Binding Name}" Width="*" />
                                        <DataGridTextColumn Header="Loại team" Binding="{Binding TeamTypeText}" Width="180" />
                                        <DataGridTextColumn Header="Business Unit" Binding="{Binding BusinessUnitName}" Width="170" />
                                        <DataGridCheckBoxColumn Header="Default" Binding="{Binding IsDefault, Mode=OneWay}" Width="70" />
                                        <DataGridTextColumn Header="Số role" Binding="{Binding RoleCount}" Width="70" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </TabItem>

                        <TabItem Header="{Binding EntityTabHeader}">
                            <DockPanel>
                                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                    <TextBox Style="{StaticResource SearchBox}" Tag="🔍 Tìm entity hoặc tên role..." Width="300"
                                             Text="{Binding EntitySearchText, UpdateSourceTrigger=PropertyChanged}" />
                                    <CheckBox Content="Chỉ entity có quyền" IsChecked="{Binding OnlyGrantedEntities}" />
                                </WrapPanel>
                                <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Muted}" Margin="0,8,0,0"
                                           Text="Quyền hiệu lực = mức cao nhất trong mọi role của user (trực tiếp + qua team). Rê chuột lên ô để xem role nào cấp. ○ None  ◔ User  ◑ BU  ◕ Parent: Child  ● Org" />
                                <DataGrid ItemsSource="{Binding EntityRowsView}" FrozenColumnCount="1">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Entity" Binding="{Binding DisplayName}" Width="200" />
                                        <c:DepthColumn Header="Create" CellPath="Create" Width="64" />
                                        <c:DepthColumn Header="Read" CellPath="Read" Width="64" />
                                        <c:DepthColumn Header="Write" CellPath="Write" Width="64" />
                                        <c:DepthColumn Header="Delete" CellPath="Delete" Width="64" />
                                        <c:DepthColumn Header="Append" CellPath="Append" Width="68" />
                                        <c:DepthColumn Header="Append To" CellPath="AppendTo" Width="80" />
                                        <c:DepthColumn Header="Assign" CellPath="Assign" Width="64" />
                                        <c:DepthColumn Header="Share" CellPath="Share" Width="64" />
                                        <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Từ role" Binding="{Binding SourcesText}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </TabItem>

                        <TabItem Header="{Binding MiscTabHeader}">
                            <DockPanel>
                                <TextBox DockPanel.Dock="Top" Style="{StaticResource SearchBox}" Tag="🔍 Tìm privilege hoặc tên role..." Width="300"
                                         HorizontalAlignment="Left" Margin="0,0,0,8" Text="{Binding MiscSearchText, UpdateSourceTrigger=PropertyChanged}" />
                                <DataGrid ItemsSource="{Binding MiscView}">
                                    <DataGrid.Columns>
                                        <c:DepthColumn Header="" CellPath="Depth" IsPrivilegeCell="False" ChangedPath="IsChanged" Width="40" />
                                        <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Privilege" Binding="{Binding Name}" Width="300" />
                                        <DataGridTextColumn Header="Mức" Binding="{Binding DepthText}" Width="140" />
                                        <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Từ role" Binding="{Binding SourcesText}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </TabItem>

                        <TabItem Header="{Binding AppsTabHeader}">
                            <DockPanel>
                            <TextBox DockPanel.Dock="Top" Style="{StaticResource SearchBox}" Tag="🔍 Tìm app..." Width="300"
                                     HorizontalAlignment="Left" Margin="0,0,0,8"
                                     Text="{Binding AppSearchText, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGrid ItemsSource="{Binding AppsView}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="App" Binding="{Binding Name}" Width="*" />
                                    <DataGridTextColumn Header="Unique Name" Binding="{Binding SubType}" Width="260" />
                                    <DataGridTextColumn Header="Trạng thái" Binding="{Binding State}" Width="100" />
                                    <DataGridTextColumn Header="Managed" Binding="{Binding ManagedText}" Width="100" />
                                </DataGrid.Columns>
                            </DataGrid>
                            </DockPanel>
                        </TabItem>

                        <TabItem Header="{Binding ProfilesTabHeader}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" Margin="0,0,0,8"
                                           Text="Field Security Profile quyết định user đọc/ghi được các cột được bảo mật (column security)." />
                                <TextBox DockPanel.Dock="Top" Style="{StaticResource SearchBox}" Tag="🔍 Tìm profile..." Width="300"
                                         HorizontalAlignment="Left" Margin="0,0,0,8"
                                         Text="{Binding ProfileSearchText, UpdateSourceTrigger=PropertyChanged}" />
                                <DataGrid ItemsSource="{Binding ProfilesView}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Field Security Profile" Binding="{Binding Name}" Width="*" />
                                        <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Nguồn" Binding="{Binding SourceText}" Width="300" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </TabItem>
                    </TabControl>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
