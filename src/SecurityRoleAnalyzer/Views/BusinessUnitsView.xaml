<UserControl x:Class="SecurityRoleAnalyzer.Views.BusinessUnitsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SecurityRoleAnalyzer.ViewModels"
             xmlns:m="clr-namespace:SecurityRoleAnalyzer.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:BusinessUnitsViewModel}"
             FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" MinWidth="220" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource Card}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Sơ đồ Business Unit" Style="{StaticResource SectionTitle}" />
                <TextBlock DockPanel.Dock="Top" Text="{Binding TreeSummary}" Style="{StaticResource Muted}" Margin="0,-4,0,8" />
                <TreeView x:Name="Tree" ItemsSource="{Binding Roots}" BorderThickness="0" SelectedItemChanged="OnSelectedItemChanged">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            <Setter Property="Padding" Value="2,3" />
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate DataType="{x:Type m:BusinessUnitNode}" ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🏢 " />
                                <TextBlock Text="{Binding Unit.Name}" FontWeight="SemiBold" />
                                <TextBlock Foreground="{StaticResource MutedTextBrush}" FontSize="11.5" VerticalAlignment="Center" Margin="6,0,0,0">
                                    <Run Text="{Binding UserCount, Mode=OneWay}" /> user · <Run Text="{Binding TeamCount, Mode=OneWay}" /> team
                                </TextBlock>
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </DockPanel>
        </Border>

        <GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Stretch" Background="Transparent" />

        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16,12">
            <Grid>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding HasAnalysis, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                    <TextBlock Text="🏢" FontSize="48" HorizontalAlignment="Center" Foreground="#9FB3C8" />
                    <TextBlock Text="Chọn một Business Unit để xem user, team, role đang dùng và phạm vi dữ liệu theo từng mức quyền" Style="{StaticResource EmptyHint}" Margin="0,8,0,0" />
                </StackPanel>

                <DockPanel Visibility="{Binding HasAnalysis, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="⬇ Xuất Excel" Command="{Binding ExportCommand}" VerticalAlignment="Top" />
                        <StackPanel>
                            <TextBlock Text="{Binding Analysis.Node.Unit.Name}" Style="{StaticResource DetailTitle}" />
                            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                        </StackPanel>
                    </DockPanel>

                    <TabControl>
                        <TabItem Header="Tổng quan">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <ItemsControl ItemsSource="{Binding SummaryCards}" Style="{StaticResource SummaryCards}" />
                                    <TextBlock Text="Phạm vi dữ liệu theo mức quyền (với user thuộc BU này)" Style="{StaticResource SectionTitle}" Margin="0,6,0,6" />
                                    <Border Style="{StaticResource InfoBanner}" Margin="0,0,10,10">
                                        <TextBlock Text="{Binding Analysis.ScopeText}" TextWrapping="Wrap" Foreground="#0B4A85" LineHeight="22" />
                                    </Border>
                                    <TextBlock Text="{Binding FindingsHeader}" Style="{StaticResource SectionTitle}" Margin="0,6,0,8" />
                                    <ItemsControl ItemsSource="{Binding Analysis.Findings}" Style="{StaticResource Findings}" />
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="{Binding UsersTabHeader}">
                            <DockPanel>
                                <TextBox DockPanel.Dock="Top" Style="{StaticResource SearchBox}" Tag="🔍 Tìm user..." Width="300" HorizontalAlignment="Left"
                                         Margin="0,0,0,8" Text="{Binding UserSearchText, UpdateSourceTrigger=PropertyChanged}" />
                                <DataGrid x:Name="UsersGrid" ItemsSource="{Binding UsersView}" ToolTip="Double-click để mở user">
                                    <DataGrid.InputBindings>
                                        <MouseBinding Gesture="LeftDoubleClick" Command="{Binding OpenUserCommand}" CommandParameter="{Binding CurrentItem, ElementName=UsersGrid}" />
                                    </DataGrid.InputBindings>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Họ tên" Binding="{Binding FullName}" Width="220" />
                                        <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Username" Binding="{Binding DomainName}" Width="*" />
                                        <DataGridTextColumn Header="Access mode" Binding="{Binding AccessModeText}" Width="140" />
                                        <DataGridTextColumn Header="Role trực tiếp" Binding="{Binding RoleCount}" Width="110" />
                                        <DataGridTextColumn Header="Trạng thái" Binding="{Binding StatusText}" Width="90" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </TabItem>

                        <TabItem Header="{Binding TeamsTabHeader}">
                            <DataGrid x:Name="TeamsGrid" ItemsSource="{Binding TeamsView}" ToolTip="Double-click để mở team">
                                <DataGrid.InputBindings>
                                    <MouseBinding Gesture="LeftDoubleClick" Command="{Binding OpenTeamCommand}" CommandParameter="{Binding CurrentItem, ElementName=TeamsGrid}" />
                                </DataGrid.InputBindings>
                                <DataGrid.Columns>
                                    <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Team" Binding="{Binding Name}" Width="*" />
                                    <DataGridTextColumn Header="Loại team" Binding="{Binding TeamTypeText}" Width="180" />
                                    <DataGridCheckBoxColumn Header="Default" Binding="{Binding IsDefault, Mode=OneWay}" Width="80" />
                                    <DataGridTextColumn Header="Số role" Binding="{Binding RoleCount}" Width="80" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>

                        <TabItem Header="{Binding RolesTabHeader}">
                            <DataGrid x:Name="RolesGrid" ItemsSource="{Binding RoleUsageView}" ToolTip="Double-click để mở role">
                                <DataGrid.InputBindings>
                                    <MouseBinding Gesture="LeftDoubleClick" Command="{Binding OpenRoleCommand}" CommandParameter="{Binding CurrentItem, ElementName=RolesGrid}" />
                                </DataGrid.InputBindings>
                                <DataGrid.Columns>
                                    <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Security Role" Binding="{Binding Name}" Width="*" />
                                    <DataGridTextColumn Header="User trực tiếp" Binding="{Binding DirectUserCount}" Width="120" />
                                    <DataGridTextColumn Header="User qua team" Binding="{Binding TeamUserCount}" Width="120" />
                                    <DataGridTextColumn Header="Tổng user" Binding="{Binding TotalUserCount}" Width="100" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                    </TabControl>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
