<Window x:Class="SecurityRoleAnalyzer.Views.SnapshotWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SecurityRoleAnalyzer.ViewModels"
        xmlns:c="clr-namespace:SecurityRoleAnalyzer.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:SnapshotViewModel}"
        Title="Snapshot &amp; so sánh môi trường" Width="1300" Height="820" WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" FontSize="13" Background="{DynamicResource AppBackgroundBrush}">
    <Grid>
        <Border Style="{StaticResource Card}" Margin="12">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource InfoBanner}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="📸 Chụp môi trường hiện tại &amp; lưu file" Command="{Binding CaptureAndSaveCommand}" Style="{StaticResource PrimaryButton}" />
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource InfoTextBrush}" VerticalAlignment="Center"
                                   Text="Snapshot lưu role, privilege, gán role cho user/team và thành viên team (theo tên, để so sánh giữa Dev ↔ UAT ↔ Prod hoặc giữa hai thời điểm)." />
                    </DockPanel>
                </Border>

                <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Background="{DynamicResource SubtleBrush}" CornerRadius="6" Padding="10,8">
                        <StackPanel>
                            <TextBlock Text="A – TRƯỚC / NGUỒN" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}" />
                            <TextBlock Text="{Binding SnapshotAText}" FontSize="14" FontWeight="SemiBold" Margin="0,4" TextTrimming="CharacterEllipsis" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Mở file..." Command="{Binding LoadACommand}" Margin="0" />
                                <Button Content="Môi trường đang kết nối" Command="{Binding UseCurrentForACommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="{DynamicResource SubtleBrush}" CornerRadius="6" Padding="10,8">
                        <StackPanel>
                            <TextBlock Text="B – SAU / ĐÍCH" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}" />
                            <TextBlock Text="{Binding SnapshotBText}" FontSize="14" FontWeight="SemiBold" Margin="0,4" TextTrimming="CharacterEllipsis" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Mở file..." Command="{Binding LoadBCommand}" Margin="0" />
                                <Button Content="Môi trường đang kết nối" Command="{Binding UseCurrentForBCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="12,0,0,0">
                        <Button Content="⇄ So sánh" Command="{Binding CompareCommand}" Style="{StaticResource PrimaryButton}" MinWidth="150" Margin="0,0,0,6" />
                        <Button Content="▶ Áp B lên môi trường này" Command="{Binding ApplyCommand}" MinWidth="150" Margin="0,0,0,6"
                                ToolTip="Đưa privilege của role trên môi trường đang kết nối về đúng như bản B" />
                        <Button Content="⬇ Xuất Excel" Command="{Binding ExportCommand}" MinWidth="150" Margin="0" />
                    </StackPanel>
                </Grid>

                <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding SummaryCards}" Style="{StaticResource SummaryCards}" />

                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding CategoryFilter}" Width="200" />
                    <ComboBox ItemsSource="{Binding ChangeTypes}" SelectedItem="{Binding ChangeFilter}" Width="140" Margin="8,0,0,0" />
                    <TextBox Style="{StaticResource SearchBox}" Tag="🔍 Tìm role, user, team, privilege..." Width="320" Margin="8,0,0,0"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                </WrapPanel>
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusText}" Style="{StaticResource Muted}" Margin="0,8,0,0" />
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding ApplyHint}" Style="{StaticResource Muted}" Margin="0,8,0,0" />
                <DataGrid ItemsSource="{Binding DiffView}" SelectionMode="Extended"
                          c:GridSelection.Enabled="True" c:GridSelection.SelectedItems="{Binding SelectedRows, Mode=OneWayToSource}"
                          ToolTip="Chọn dòng để chỉ áp những thay đổi đó; không chọn dòng nào thì áp tất cả.">
                    <DataGrid.Columns>
                        <c:SelectColumn />
                        <DataGridTextColumn Header="Loại" Binding="{Binding Category}" Width="160" />
                        <DataGridTextColumn Header="Thay đổi" Binding="{Binding ChangeType}" Width="100" />
                        <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Đối tượng" Binding="{Binding Item}" Width="*" />
                        <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Chi tiết" Binding="{Binding Detail}" Width="*" />
                        <DataGridTextColumn Header="A (trước)" Binding="{Binding Before}" Width="130" />
                        <DataGridTextColumn Header="B (sau)" Binding="{Binding After}" Width="130" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <Grid Background="{DynamicResource OverlayBrush}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
            <Border Style="{StaticResource Card}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28,20" MinWidth="360">
                <StackPanel>
                    <TextBlock Text="{Binding BusyText}" HorizontalAlignment="Center" TextWrapping="Wrap" />
                    <ProgressBar Height="6" Margin="0,14,0,0" Minimum="0" Maximum="100" Value="{Binding BusyProgress, Mode=OneWay}"
                                 IsIndeterminate="{Binding HasProgressValue, Converter={StaticResource InverseBool}}" />
                    <TextBlock Text="{Binding ProgressText}" HorizontalAlignment="Center" Margin="0,6,0,0"
                               Foreground="{DynamicResource MutedTextBrush}"
                               Visibility="{Binding HasProgressValue, Converter={StaticResource BoolToVisibility}}" />
                    <Button Content="Hủy" Command="{Binding CancelCommand}" HorizontalAlignment="Center" Margin="0,12,0,0" MinWidth="100"
                            Visibility="{Binding CanCancel, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
